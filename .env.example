TYPESAFE_API_KEY=
# 설정하면 수신 API 가 "Authorization: Bearer <토큰>" 을 요구한다.
INGEST_TOKEN=
# 웹 화면(/web/wiki, /web/flow) 토큰. 비우면 화면을 닫는다
WEB_TOKEN=
# DATA_DIR=data
# TIMEZONE=Asia/Seoul
# JEV_MODEL=jev-latest
# JEV_KEEP_THRESHOLD=0.3
# PROMPTS_DIR=prompts
# MESSAGE_SETTLE_SECONDS=30
# 받을 카카오톡 알림 채널. quiet_new_message(알림 끈 방, 카톡 방해금지 시간대)는 기본으로 받지 않는다
# KAKAO_CHANNELS='["new_message_v6"]'
# 카톡 방 단위 판단 (Jev → Claude → 캘린더). 끄면 알림 하나씩 판별한다
# KAKAO_JUDGE_ENABLED=true
# KAKAO_JUDGE_WINDOW=20
# KAKAO_JUDGE_SETTLE_SECONDS=70
# KAKAO_JUDGE_PHONE_SETTLE_SECONDS=20
# KAKAO_JUDGE_MAX_WAIT_SECONDS=300
# KAKAO_JUDGE_MAX_AGE_HOURS=12
# 전화 수신 브리핑 (POST /v1/brief/call). 최근 카톡·문자를 claude 로 3줄 요약
# BRIEF_MODEL=haiku
# BRIEF_EFFORT=low
# BRIEF_TIMEOUT_SECONDS=15
# BRIEF_DAYS=30
# BRIEF_MAX_MESSAGES=40
# WHISPER_MODEL_DIR=/home/automan/whisper/large-v3-turbo
# WHISPER_LANGUAGE=ko
# WHISPER_CPU_THREADS=2
# DIARIZATION_ENABLED=true
# DIARIZATION_NUM_SPEAKERS=2
# 메일 폴러 (python -m app.jobs.mail_poller)
# MAIL_ACCOUNTS='[{"name": "naver-main", "user": "아이디", "password": "앱 비밀번호"}]'
# MAIL_POLL_SECONDS=300
# MAIL_BACKFILL_DAYS=1
